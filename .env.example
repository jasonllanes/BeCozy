# Copy to .env and fill in (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional: a TURN relay helps online video connect on strict networks (school/office/mobile).
# Comma-separate several URLs. Leave unset to use free Google STUN only.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
